rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers & Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOptString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptNumber(data, field) {
      return !(field in data) || data[field] == null || (data[field] is number);
    }

    function isOptBool(data, field) {
      return !(field in data) || data[field] == null || (data[field] is bool);
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'name']) &&
        data.keys().hasOnly(['uid', 'email', 'name', 'photoURL', 'mobile', 'address', 'pincode', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 200 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isOptString(data, 'photoURL', 1000) &&
        isOptString(data, 'mobile', 30) &&
        isOptString(data, 'address', 500) &&
        isOptString(data, 'pincode', 20);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price']) &&
        data.keys().hasOnly([
          'name', 'price', 'discountPrice', 'description', 'imageUrl', 'galleryImages',
          'category', 'tag', 'placement', 'sectionLabel', 'visible', 'isDemo', 'rating', 'reviewsCount',
          'features', 'stock', 'gstPercent', 'deliveryCharge', 'estimatedDeliveryDays',
          'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.price is number && data.price >= 0 &&
        isOptNumber(data, 'discountPrice') &&
        isOptString(data, 'description', 2000) &&
        isOptString(data, 'imageUrl', 950000) &&
        isOptString(data, 'category', 100) &&
        isOptString(data, 'tag', 60) &&
        (!('placement' in data) || data.placement == null || data.placement in ['grid', 'banner', 'deals', 'spotlight']) &&
        isOptString(data, 'sectionLabel', 80) &&
        isOptBool(data, 'visible') &&
        isOptBool(data, 'isDemo') &&
        isOptNumber(data, 'rating') &&
        isOptNumber(data, 'reviewsCount') &&
        isOptNumber(data, 'stock') &&
        isOptNumber(data, 'gstPercent') &&
        isOptNumber(data, 'deliveryCharge') &&
        isOptString(data, 'estimatedDeliveryDays', 100) &&
        (!('galleryImages' in data) || (data.galleryImages is list && data.galleryImages.size() <= 15 && (data.galleryImages.size() == 0 || (data.galleryImages[0] is string && data.galleryImages[0].size() <= 950000)))) &&
        (!('features' in data) || (data.features is list && data.features.size() <= 20 && (data.features.size() == 0 || (data.features[0] is string && data.features[0].size() <= 200))));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'visible']) &&
        data.keys().hasOnly([
          'id', 'name', 'imageUrl', 'visible', 'sortOrder', 'isDemo', 'subTags', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.visible is bool &&
        isOptString(data, 'imageUrl', 950000) &&
        isOptNumber(data, 'sortOrder') &&
        isOptBool(data, 'isDemo') &&
        isOptString(data, 'updatedAt', 100) &&
        (!('subTags' in data) || (data.subTags is list && data.subTags.size() <= 15 && (data.subTags.size() == 0 || (data.subTags[0] is string && data.subTags[0].size() <= 60))));
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['orderId', 'userId', 'customerName', 'phoneNumber', 'productId', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'orderId', 'userId', 'userEmail', 'userName', 'userPhoto', 'customerName',
          'phoneNumber', 'address', 'pincode', 'productId', 'productName', 'productImage',
          'productPrice', 'gstPercent', 'gstAmount', 'gstNumber', 'deliveryCharge',
          'estimatedDeliveryDays', 'price', 'paymentMethod', 'paymentScreenshot',
          'referralCode', 'promoterId', 'promoterUserId', 'promoterEmail',
          'promoterCommission', 'trackingId', 'trackingUrl', 'courierName',
          'deliveryStatus', 'dispatchedAt', 'deliveredAt', 'status', 'createdAt'
        ]) &&
        data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 64 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.phoneNumber is string && data.phoneNumber.size() >= 1 && data.phoneNumber.size() <= 30 &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
        data.status in ['pending', 'pending_verification', 'confirmed', 'rejected', 'cancelled', 'completed'] &&
        (!('deliveryStatus' in data) || data.deliveryStatus == null || data.deliveryStatus in ['pending', 'shipped', 'delivered']) &&
        isOptString(data, 'userEmail', 200) &&
        isOptString(data, 'userName', 120) &&
        isOptString(data, 'userPhoto', 1000) &&
        isOptString(data, 'address', 500) &&
        isOptString(data, 'pincode', 20) &&
        isOptString(data, 'productName', 200) &&
        isOptString(data, 'productImage', 950000) &&
        isOptNumber(data, 'productPrice') &&
        isOptNumber(data, 'gstPercent') &&
        isOptNumber(data, 'gstAmount') &&
        isOptString(data, 'gstNumber', 64) &&
        isOptNumber(data, 'deliveryCharge') &&
        isOptString(data, 'estimatedDeliveryDays', 100) &&
        isOptNumber(data, 'price') &&
        isOptString(data, 'paymentMethod', 50) &&
        isOptString(data, 'paymentScreenshot', 950000) &&
        isOptString(data, 'referralCode', 64) &&
        isOptString(data, 'promoterId', 64) &&
        isOptString(data, 'promoterUserId', 128) &&
        isOptString(data, 'promoterEmail', 200) &&
        isOptNumber(data, 'promoterCommission') &&
        isOptString(data, 'trackingId', 120) &&
        isOptString(data, 'trackingUrl', 500) &&
        isOptString(data, 'courierName', 100) &&
        isOptString(data, 'dispatchedAt', 100) &&
        isOptString(data, 'deliveredAt', 100);
    }

    function isValidPromoter(data) {
      return data.keys().hasAll(['id', 'userId', 'email', 'name', 'phone']) &&
        data.keys().hasOnly([
          'id', 'name', 'phone', 'email', 'userId', 'channelName', 'paymentType',
          'upiId', 'bankName', 'accountNumber', 'ifscCode', 'accountHolderName',
          'createdAt', 'commissionPerSale', 'paidAmount'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.email is string && data.email.size() >= 1 && data.email.size() <= 200 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 30 &&
        isOptString(data, 'channelName', 120) &&
        (!('paymentType' in data) || data.paymentType == null || data.paymentType in ['upi', 'bank']) &&
        isOptString(data, 'upiId', 120) &&
        isOptString(data, 'bankName', 120) &&
        isOptString(data, 'accountNumber', 64) &&
        isOptString(data, 'ifscCode', 32) &&
        isOptString(data, 'accountHolderName', 120) &&
        isOptString(data, 'createdAt', 100) &&
        isOptNumber(data, 'commissionPerSale') &&
        isOptNumber(data, 'paidAmount');
    }

    function isValidPromoterRef(data) {
      return data.keys().hasAll(['id', 'promoterUserId', 'commissionPerSale']) &&
        data.keys().hasOnly(['id', 'promoterUserId', 'commissionPerSale']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.promoterUserId is string && data.promoterUserId.size() >= 1 && data.promoterUserId.size() <= 128 &&
        data.commissionPerSale is number && data.commissionPerSale >= 0;
    }

    function isValidPromoterSale(data) {
      return data.keys().hasAll(['orderId', 'buyerUserId', 'promoterId', 'productId', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'orderId', 'bookingDocId', 'buyerUserId', 'promoterId', 'promoterUserId',
          'promoterEmail', 'productId', 'productName', 'price', 'commission',
          'deliveryStatus', 'courierName', 'trackingId', 'dispatchedAt', 'deliveredAt',
          'status', 'createdAt'
        ]) &&
        data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 64 &&
        data.buyerUserId is string && data.buyerUserId.size() >= 1 && data.buyerUserId.size() <= 128 &&
        data.promoterId is string && data.promoterId.size() >= 1 && data.promoterId.size() <= 64 &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
        data.status in ['pending', 'pending_verification', 'confirmed', 'rejected', 'cancelled', 'completed'] &&
        (!('deliveryStatus' in data) || data.deliveryStatus == null || data.deliveryStatus in ['pending', 'shipped', 'delivered']) &&
        isOptString(data, 'bookingDocId', 128) &&
        isOptString(data, 'promoterUserId', 128) &&
        isOptString(data, 'promoterEmail', 200) &&
        isOptString(data, 'productName', 200) &&
        isOptNumber(data, 'price') &&
        isOptNumber(data, 'commission') &&
        isOptString(data, 'courierName', 100) &&
        isOptString(data, 'trackingId', 120) &&
        isOptString(data, 'dispatchedAt', 100) &&
        isOptString(data, 'deliveredAt', 100);
    }

    function isValidCatalogSetting(data) {
      return data.keys().hasAll(['initialized']) &&
        data.keys().hasOnly(['initialized', 'deletedIds', 'updatedAt']) &&
        data.initialized is bool &&
        (!('deletedIds' in data) || (data.deletedIds is list && data.deletedIds.size() <= 200 && (data.deletedIds.size() == 0 || (data.deletedIds[0] is string && data.deletedIds[0].size() <= 128))));
    }

    function isValidCategoriesSetting(data) {
      return data.keys().hasAll(['list']) &&
        data.keys().hasOnly(['list', 'initialized', 'deletedCategoryIds', 'updatedAt']) &&
        data.list is list &&
        data.list.size() <= 150 &&
        (data.list.size() == 0 || (data.list[0] is string && data.list[0].size() <= 100)) &&
        isOptBool(data, 'initialized') &&
        (!('deletedCategoryIds' in data) || (data.deletedCategoryIds is list && data.deletedCategoryIds.size() <= 200 && (data.deletedCategoryIds.size() == 0 || (data.deletedCategoryIds[0] is string && data.deletedCategoryIds[0].size() <= 128))));
    }

    function isValidOrderCounterSetting(data) {
      return data.keys().hasAll(['nextVal']) &&
        data.keys().hasOnly(['nextVal']) &&
        data.nextVal is number &&
        data.nextVal >= 1;
    }

    function isValidPaymentSetting(data) {
      return data.keys().hasOnly([
          'enableCOD', 'enableUPI', 'enableCard', 'merchantUpiId', 'whatsappNumber',
          'storeBaseUrl', 'gstNumber', 'pickupName', 'pickupPhone', 'pickupAddress',
          'pickupPincode', 'defaultDeliveryDays', 'blockAccountOrders',
          'blockAccountWishlist', 'blockAccountCoupons', 'blockAccountHelp',
          'enableLocationBar', 'enableLoginButton', 'enableWhatsAppWidget',
          'enableHeroBanner', 'enableValueDeals', 'enableSpotlight', 'enableSuggestedGrid',
          'enablePaymentGateway', 'paymentGatewayName', 'paymentGatewayMode', 'paymentGatewayCode',
          'sectionTitleBanner', 'sectionTitleDeals', 'sectionTitleSpotlight', 'sectionTitleGrid',
          'updatedAt'
        ]) &&
        isOptBool(data, 'enableCOD') &&
        isOptBool(data, 'enableUPI') &&
        isOptBool(data, 'enableCard') &&
        isOptString(data, 'merchantUpiId', 120) &&
        isOptString(data, 'whatsappNumber', 30) &&
        isOptString(data, 'storeBaseUrl', 300) &&
        isOptString(data, 'gstNumber', 64) &&
        isOptString(data, 'pickupName', 120) &&
        isOptString(data, 'pickupPhone', 30) &&
        isOptString(data, 'pickupAddress', 500) &&
        isOptString(data, 'pickupPincode', 20) &&
        isOptString(data, 'defaultDeliveryDays', 100) &&
        isOptBool(data, 'blockAccountOrders') &&
        isOptBool(data, 'blockAccountWishlist') &&
        isOptBool(data, 'blockAccountCoupons') &&
        isOptBool(data, 'blockAccountHelp') &&
        isOptBool(data, 'enableLocationBar') &&
        isOptBool(data, 'enableLoginButton') &&
        isOptBool(data, 'enableWhatsAppWidget') &&
        isOptBool(data, 'enableHeroBanner') &&
        isOptBool(data, 'enableValueDeals') &&
        isOptBool(data, 'enableSpotlight') &&
        isOptBool(data, 'enableSuggestedGrid') &&
        isOptBool(data, 'enablePaymentGateway') &&
        isOptString(data, 'paymentGatewayName', 100) &&
        (!('paymentGatewayMode' in data) || data.paymentGatewayMode == null || data.paymentGatewayMode in ['test', 'live']) &&
        isOptString(data, 'paymentGatewayCode', 10000) &&
        isOptString(data, 'sectionTitleBanner', 80) &&
        isOptString(data, 'sectionTitleDeals', 80) &&
        isOptString(data, 'sectionTitleSpotlight', 80) &&
        isOptString(data, 'sectionTitleGrid', 80);
    }

    function isValidLiveSetting(data) {
      return data.keys().hasAll(['active', 'headerLabel']) &&
        data.keys().hasOnly([
          'active', 'headerLabel', 'subtitle', 'durationHours', 'durationMinutes',
          'durationText', 'startedAt', 'endsAt', 'defaultDiscountPercent',
          'defaultOfferAmount', 'liveBoxes', 'deletedLiveIds', 'updatedAt'
        ]) &&
        data.active is bool &&
        data.headerLabel is string && data.headerLabel.size() >= 1 && data.headerLabel.size() <= 80 &&
        isOptString(data, 'subtitle', 200) &&
        isOptNumber(data, 'durationHours') &&
        isOptNumber(data, 'durationMinutes') &&
        isOptString(data, 'durationText', 100) &&
        isOptString(data, 'startedAt', 100) &&
        isOptString(data, 'endsAt', 100) &&
        isOptNumber(data, 'defaultDiscountPercent') &&
        isOptNumber(data, 'defaultOfferAmount') &&
        isOptString(data, 'updatedAt', 100) &&
        (!('liveBoxes' in data) || (data.liveBoxes is list && data.liveBoxes.size() <= 20)) &&
        (!('deletedLiveIds' in data) || (data.deletedLiveIds is list && data.deletedLiveIds.size() <= 200 && (data.deletedLiveIds.size() == 0 || (data.deletedLiveIds[0] is string && data.deletedLiveIds[0].size() <= 128))));
    }

    function isValidLiveItem(data) {
      return data.keys().hasAll(['id', 'title', 'originalPrice', 'offerPrice', 'visible']) &&
        data.keys().hasOnly([
          'id', 'boxId', 'sectionName', 'title', 'modelName', 'category', 'originalPrice', 'offerPrice',
          'discountPercent', 'offerAmount', 'tag', 'description', 'images', 'videos',
          'linkedProductId', 'visible', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        isOptString(data, 'boxId', 64) &&
        isOptString(data, 'sectionName', 80) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.originalPrice is number && data.originalPrice >= 0 &&
        data.offerPrice is number && data.offerPrice >= 0 &&
        data.visible is bool &&
        isOptString(data, 'modelName', 120) &&
        isOptString(data, 'category', 100) &&
        isOptNumber(data, 'discountPercent') &&
        isOptNumber(data, 'offerAmount') &&
        isOptString(data, 'tag', 80) &&
        isOptString(data, 'description', 2000) &&
        isOptString(data, 'linkedProductId', 128) &&
        isOptNumber(data, 'sortOrder') &&
        isOptString(data, 'createdAt', 100) &&
        isOptString(data, 'updatedAt', 100) &&
        (!('images' in data) || (data.images is list && data.images.size() <= 15 && (data.images.size() == 0 || (data.images[0] is string && data.images[0].size() <= 950000)))) &&
        (!('videos' in data) || (data.videos is list && data.videos.size() <= 10 && (data.videos.size() == 0 || (data.videos[0] is string && data.videos[0].size() <= 950000))));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'rating', 'comment', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'productId', 'productName', 'userId', 'userEmail', 'userName',
          'location', 'rating', 'comment', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 2000 &&
        isOptString(data, 'id', 128) &&
        isOptString(data, 'productName', 200) &&
        isOptString(data, 'userId', 128) &&
        isOptString(data, 'userEmail', 200) &&
        isOptString(data, 'userName', 120) &&
        isOptString(data, 'location', 120) &&
        isOptString(data, 'status', 50) &&
        isOptString(data, 'createdAt', 100) &&
        isOptString(data, 'updatedAt', 100);
    }

    // 4. Collection Rules
    match /test/connection {
      allow get: if true;
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if isValidId(productId);
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId);
    }

    match /live_items/{itemId} {
      allow get, list: if true;
      allow create, update: if isValidId(itemId) && isValidLiveItem(incoming());
      allow delete: if isValidId(itemId);
    }

    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isValidId(userId);
    }

    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create: if isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().status in ['pending', 'pending_verification'] &&
        incoming().createdAt == request.time;
      allow update: if isValidId(bookingId) && isValidBooking(incoming());
      allow delete: if isValidId(bookingId);
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isValidId(settingId) && (
        (settingId == 'order_counter' && isValidOrderCounterSetting(incoming())) ||
        (settingId == 'categories' && isValidCategoriesSetting(incoming())) ||
        (settingId == 'catalog' && isValidCatalogSetting(incoming())) ||
        (settingId == 'payment' && isValidPaymentSetting(incoming())) ||
        (settingId == 'live' && isValidLiveSetting(incoming()))
      );
      allow delete: if isValidId(settingId);
    }

    match /promoter_refs/{promoterId} {
      allow get, list: if true;
      allow create, update: if isValidId(promoterId) && isValidPromoterRef(incoming());
      allow delete: if isValidId(promoterId);
    }

    match /promoters/{promoterId} {
      allow get, list: if true;
      allow create, update: if isValidId(promoterId) && isValidPromoter(incoming());
      allow delete: if isValidId(promoterId);
    }

    match /promoter_sales/{saleId} {
      allow get, list: if true;
      allow create: if isValidId(saleId) && isValidPromoterSale(incoming()) &&
        incoming().status in ['pending', 'pending_verification'] &&
        incoming().createdAt == request.time;
      allow update: if isValidId(saleId) && isValidPromoterSale(incoming());
      allow delete: if isValidId(saleId);
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create, update: if isValidId(reviewId) && isValidReview(incoming());
      allow delete: if isValidId(reviewId);
    }
  }
}
