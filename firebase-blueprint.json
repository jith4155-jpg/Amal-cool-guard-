{
  "entities": {
    "booking": {
      "title": "Booking",
      "description": "A customer booking request tied to a verified user account.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 120 },
        "userPhoto": { "type": "string", "maxLength": 1000 },
        "customerName": { "type": "string", "maxLength": 120 },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 500 },
        "pincode": { "type": "string", "maxLength": 20 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "productImage": { "type": "string", "maxLength": 950000 },
        "productPrice": { "type": "number" },
        "gstPercent": { "type": "number" },
        "gstAmount": { "type": "number" },
        "gstNumber": { "type": "string", "maxLength": 64 },
        "deliveryCharge": { "type": "number" },
        "estimatedDeliveryDays": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentScreenshot": { "type": "string", "maxLength": 950000 },
        "referralCode": { "type": "string", "maxLength": 64 },
        "promoterId": { "type": "string", "maxLength": 64 },
        "promoterUserId": { "type": "string", "maxLength": 128 },
        "promoterEmail": { "type": "string", "maxLength": 200 },
        "promoterCommission": { "type": "number" },
        "trackingId": { "type": "string", "maxLength": 120 },
        "trackingUrl": { "type": "string", "maxLength": 500 },
        "courierName": { "type": "string", "maxLength": 100 },
        "deliveryStatus": {
          "type": "string",
          "enum": ["pending", "shipped", "delivered"]
        },
        "dispatchedAt": { "type": "string", "maxLength": 100 },
        "deliveredAt": { "type": "string", "maxLength": 100 },
        "status": {
          "type": "string",
          "enum": ["pending", "pending_verification", "confirmed", "rejected", "cancelled", "completed"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "userId", "customerName", "phoneNumber", "productId", "status", "createdAt"]
    },
    "userProfile": {
      "title": "UserProfile",
      "description": "Private authenticated customer profile keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "mobile": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 500 },
        "pincode": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name"]
    },
    "product": {
      "title": "Product",
      "description": "A product or multi-photo showcase card available for booking in the storefront.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "price": { "type": "number" },
        "discountPrice": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 950000 },
        "galleryImages": { "type": "array" },
        "category": { "type": "string", "maxLength": 100 },
        "tag": { "type": "string", "maxLength": 60 },
        "placement": { "type": "string", "enum": ["grid", "banner", "deals", "spotlight"] },
        "sectionLabel": { "type": "string", "maxLength": 80 },
        "visible": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "features": { "type": "array" },
        "stock": { "type": "number" },
        "gstPercent": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "estimatedDeliveryDays": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price"]
    },
    "category": {
      "title": "Category",
      "description": "Storefront category with auto-matched or custom image, visibility toggle, and sort order.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 950000 },
        "visible": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "isDemo": { "type": "boolean" },
        "subTags": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "visible"]
    },
    "promoter": {
      "title": "Promoter",
      "description": "Private Affiliate / Promoter profile and payout details bound to a verified Gmail account.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "channelName": { "type": "string", "maxLength": 120 },
        "paymentType": { "type": "string", "enum": ["upi", "bank"] },
        "upiId": { "type": "string", "maxLength": 120 },
        "bankName": { "type": "string", "maxLength": 120 },
        "accountNumber": { "type": "string", "maxLength": 64 },
        "ifscCode": { "type": "string", "maxLength": 32 },
        "accountHolderName": { "type": "string", "maxLength": 120 },
        "commissionPerSale": { "type": "number" },
        "paidAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "email", "name", "phone"]
    },
    "promoterRef": {
      "title": "PromoterRef",
      "description": "PII-free public referral routing metadata keyed by promoter code.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "promoterUserId": { "type": "string", "maxLength": 128 },
        "commissionPerSale": { "type": "number" }
      },
      "required": ["id", "promoterUserId", "commissionPerSale"]
    },
    "promoterSale": {
      "title": "PromoterSale",
      "description": "PII-free referral order summary so promoters see their own referred product counts and earnings securely.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 64 },
        "bookingDocId": { "type": "string", "maxLength": 128 },
        "buyerUserId": { "type": "string", "maxLength": 128 },
        "promoterId": { "type": "string", "maxLength": 64 },
        "promoterUserId": { "type": "string", "maxLength": 128 },
        "promoterEmail": { "type": "string", "maxLength": 200 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "price": { "type": "number" },
        "commission": { "type": "number" },
        "deliveryStatus": {
          "type": "string",
          "enum": ["pending", "shipped", "delivered"]
        },
        "courierName": { "type": "string", "maxLength": 100 },
        "trackingId": { "type": "string", "maxLength": 120 },
        "dispatchedAt": { "type": "string", "maxLength": 100 },
        "deliveredAt": { "type": "string", "maxLength": 100 },
        "status": {
          "type": "string",
          "enum": ["pending", "pending_verification", "confirmed", "rejected", "cancelled", "completed"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "buyerUserId", "promoterId", "productId", "status", "createdAt"]
    },
    "setting": {
      "title": "StoreSetting",
      "description": "Storefront configuration documents (payment, categories, catalog, order_counter).",
      "type": "object",
      "properties": {
        "nextVal": { "type": "number" },
        "list": { "type": "array" },
        "initialized": { "type": "boolean" },
        "deletedIds": { "type": "array" },
        "deletedCategoryIds": { "type": "array" },
        "enableCOD": { "type": "boolean" },
        "enableUPI": { "type": "boolean" },
        "enableCard": { "type": "boolean" },
        "merchantUpiId": { "type": "string", "maxLength": 120 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "storeBaseUrl": { "type": "string", "maxLength": 300 },
        "gstNumber": { "type": "string", "maxLength": 64 },
        "pickupName": { "type": "string", "maxLength": 120 },
        "pickupPhone": { "type": "string", "maxLength": 30 },
        "pickupAddress": { "type": "string", "maxLength": 500 },
        "pickupPincode": { "type": "string", "maxLength": 20 },
        "defaultDeliveryDays": { "type": "string", "maxLength": 100 },
        "blockAccountOrders": { "type": "boolean" },
        "blockAccountWishlist": { "type": "boolean" },
        "blockAccountCoupons": { "type": "boolean" },
        "blockAccountHelp": { "type": "boolean" },
        "enableLocationBar": { "type": "boolean" },
        "enableLoginButton": { "type": "boolean" },
        "enableWhatsAppWidget": { "type": "boolean" },
        "enableHeroBanner": { "type": "boolean" },
        "enableValueDeals": { "type": "boolean" },
        "enableSpotlight": { "type": "boolean" },
        "enableSuggestedGrid": { "type": "boolean" },
        "enablePaymentGateway": { "type": "boolean" },
        "paymentGatewayName": { "type": "string", "maxLength": 100 },
        "paymentGatewayMode": { "type": "string", "enum": ["test", "live"] },
        "paymentGatewayCode": { "type": "string", "maxLength": 10000 },
        "sectionTitleBanner": { "type": "string", "maxLength": 80 },
        "sectionTitleDeals": { "type": "string", "maxLength": 80 },
        "sectionTitleSpotlight": { "type": "string", "maxLength": 80 },
        "sectionTitleGrid": { "type": "string", "maxLength": 80 },
        "active": { "type": "boolean" },
        "headerLabel": { "type": "string", "maxLength": 80 },
        "subtitle": { "type": "string", "maxLength": 200 },
        "durationHours": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "durationText": { "type": "string", "maxLength": 100 },
        "startedAt": { "type": "string", "maxLength": 100 },
        "endsAt": { "type": "string", "maxLength": 100 },
        "defaultDiscountPercent": { "type": "number" },
        "defaultOfferAmount": { "type": "number" },
        "liveBoxes": { "type": "array" },
        "deletedLiveIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "liveItem": {
      "title": "LiveSaleItem",
      "description": "Live sale product/model card with offer pricing, % discount, multi-images, and video links.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "boxId": { "type": "string", "maxLength": 64 },
        "sectionName": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "maxLength": 200 },
        "modelName": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 100 },
        "originalPrice": { "type": "number" },
        "offerPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "offerAmount": { "type": "number" },
        "tag": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 2000 },
        "images": { "type": "array" },
        "videos": { "type": "array" },
        "linkedProductId": { "type": "string", "maxLength": 128 },
        "visible": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "originalPrice", "offerPrice", "visible"]
    },
    "review": {
      "title": "ProductReview",
      "description": "Customer ratings and reviews submitted from storefront or managed in Admin Panel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 120 },
        "location": { "type": "string", "maxLength": 120 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "booking",
      "description": "Customer bookings collection with strict owner-based read/delete and admin management."
    },
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "Private customer profiles keyed by Firebase Auth UID."
    },
    "/products/{productId}": {
      "schema": "product",
      "description": "Storefront product catalog."
    },
    "/categories/{categoryId}": {
      "schema": "category",
      "description": "Storefront categories with image, visibility toggle, and ordering."
    },
    "/live_items/{itemId}": {
      "schema": "liveItem",
      "description": "Live sale cards/models with offers, discounts, multi-images, and video previews."
    },
    "/promoters/{promoterId}": {
      "schema": "promoter",
      "description": "Private promoter & affiliate profiles bound to verified Gmail accounts."
    },
    "/promoter_refs/{promoterId}": {
      "schema": "promoterRef",
      "description": "PII-free referral lookup metadata keyed by promoter code."
    },
    "/promoter_sales/{saleId}": {
      "schema": "promoterSale",
      "description": "PII-free referral sales summary readable only by the owning promoter, buyer, or admin."
    },
    "/settings/{settingId}": {
      "schema": "setting",
      "description": "Store configuration docs: payment, categories, catalog, order_counter, live."
    },
    "/reviews/{reviewId}": {
      "schema": "review",
      "description": "Customer ratings and reviews collection accessible by customers and admin."
    }
  }
}
